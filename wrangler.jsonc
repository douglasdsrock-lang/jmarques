{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jmarques",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ALLOWED_ORIGINS": ""
  }
}
